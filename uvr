class ConfigDict(dict):
    """Configuration dictionary that allows attribute-style access."""
    def __getattr__(self, name):
        if name in self:
            value = self[name]
            if isinstance(value, dict):
                return ConfigDict(value)
            return value
        raise AttributeError(f"No such attribute: {name}")

    def __setattr__(self, name, value):
        self[name] = value

    def __delattr__(self, name):
        if name in self:
            del self[name]
        else:
            raise AttributeError(f"No such attribute: {name}")

def secondary_stem(stem):
    return "Vocals" if stem == "Instrumental" else "Instrumental" # Simplification for typical usage

