                        if getattr(self.mdx_c_configs.training, 'target_instrument', None):
                            self.primary_stem = self.mdx_c_configs.training.target_instrument
                        else:
                            self.mdx_model_stems = self.mdx_c_configs.training.instruments
                            self.mdx_stem_count = len(self.mdx_model_stems)
                            self.primary_stem = self.mdx_model_stems[0] if self.mdx_stem_count == 2 else self.mdxnet_stem_select
                    self.secondary_stem = secondary_stem(self.primary_stem)
                else:
                    self.compensate = self.model_data_dict.get("compensate", 1.035)
                    self.mdx_dim_f_set = self.model_data_dict.get("mdx_dim_f_set", 2048)
                    self.mdx_dim_t_set = self.model_data_dict.get("mdx_dim_t_set", 8)
                    self.mdx_n_fft_scale_set = self.model_data_dict.get("mdx_n_fft_scale_set", 6144)
                    self.primary_stem = self.model_data_dict.get("primary_stem", "Instrumental")
                    self.primary_stem_native = self.primary_stem
                    self.secondary_stem = secondary_stem(self.primary_stem)
            else:
                print(f"Warning: MDX model hash {self.model_hash} not found.", file=sys.stderr)
                self.primary_stem = "Instrumental"
                self.secondary_stem = "Vocals"
                self.primary_stem_native = self.primary_stem

        elif self.process_method == DEMUCS_ARCH_TYPE:
            self.margin_demucs = 44000
            self.chunks_demucs = 0
            self.shifts = kwargs.get('shifts', 2)
            self.is_split_mode = True
            self.segment = "Default"
            self.is_chunk_demucs = False
            self.demucs_version = "v4"
            # In a full implementation, Demucs configs would be mapped properly
            self.primary_stem = "Instrumental"
            self.secondary_stem = "Vocals"
            pass

    def get_model_hash(self):
        if not os.path.isfile(self.model_path):
            return None
        try:
            with open(self.model_path, 'rb') as f:
                f.seek(- 10000 * 1024, 2)
                return hashlib.md5(f.read()).hexdigest()
        except:
            with open(self.model_path, 'rb') as f:
                return hashlib.md5(f.read()).hexdigest()

    def get_model_data_from_json(self, json_path):
        if os.path.isfile(json_path):
            with open(json_path, 'r') as f:
                data = json.load(f)
                if self.model_hash in data:
                    return data[self.model_hash]
        return None

def set_progress_bar(value, *args, **kwargs):
    print(f"Progress: {value*100:.1f}%")

def write_to_console(message, *args, **kwargs):
    print(message)

def main():
    parser = argparse.ArgumentParser(description="Ultimate Vocal Remover CLI - Headless audio separation tool")
    parser.add_argument("--input", "-i", type=str, required=True, help="Input audio file path")
    parser.add_argument("--model", "-m", type=str, required=True, help="Model name or file path (Supported Architectures: VR Arc, MDX-Net, Demucs)")
    parser.add_argument("--export_path", "-o", type=str, help="Output directory destination")
    parser.add_argument("--format", type=str, default="wav", help="Export format (wav, flac, mp3, etc.)")
    parser.add_argument("--dry-run", action="store_true", help="Dry run mode to validate model and dependencies")
    parser.add_argument("--config", "-c", type=str, help="Path to JSON configuration file for advanced parameters (sample rate, hop length, etc.)")
    
    # Optional direct CLI flags
    parser.add_argument("--window_size", type=int, default=512, help="Window size for VR models")
    parser.add_argument("--aggression", type=int, default=5, help="Aggressiveness setting for VR models (0-100)")
    parser.add_argument("--tta", action="store_true", help="Enable Test-Time Augmentation")
    
    args = parser.parse_args()

    input_file = os.path.abspath(args.input)
    if not os.path.isfile(input_file):
        print(f"Error: Input file {input_file} not found.", file=sys.stderr)
        sys.exit(1)

    export_path = os.path.abspath(args.export_path) if args.export_path else os.path.dirname(input_file)
    if not os.path.exists(export_path):
        os.makedirs(export_path)

    model_path = args.model
    if not os.path.isabs(model_path):
        # Try to find model in directories
        if os.path.isfile(os.path.join(VR_MODELS_DIR, args.model)):
            model_path = os.path.join(VR_MODELS_DIR, args.model)
            process_method = VR_ARCH_TYPE
        elif os.path.isfile(os.path.join(MDX_MODELS_DIR, args.model)):
            model_path = os.path.join(MDX_MODELS_DIR, args.model)
            process_method = MDX_ARCH_TYPE
        elif os.path.isfile(os.path.join(DEMUCS_MODELS_DIR, args.model)):
            model_path = os.path.join(DEMUCS_MODELS_DIR, args.model)
            process_method = DEMUCS_ARCH_TYPE
        else:
            print(f"Error: Model {args.model} not found in model directories.", file=sys.stderr)
            sys.exit(1)
    else:
        # Determine process_method from path
        if "VR_Models" in model_path: process_method = VR_ARCH_TYPE
        elif "MDX_Net_Models" in model_path: process_method = MDX_ARCH_TYPE
        else: process_method = DEMUCS_ARCH_TYPE

    model_name = os.path.basename(model_path)

    print(f"Loading {process_method} model: {model_name}...")

    # Build model data kwargs
    kwargs = vars(args)
    if args.config and os.path.isfile(args.config):
        with open(args.config, 'r') as f:
            config_data = json.load(f)
            kwargs.update(config_data)
            
    kwargs['process_method'] = process_method
    kwargs['model_path'] = model_path
    
    model_data = CLIModelData(model_name, **kwargs)

    audio_file_base = os.path.splitext(os.path.basename(input_file))[0]

    process_data = {
        'model_data': model_data,
        'export_path': export_path,
        'audio_file_base': audio_file_base,
        'audio_file': input_file,
        'set_progress_bar': set_progress_bar,
        'write_to_console': write_to_console,
        'process_iteration': lambda: None, # Dummy function
        'cached_source_callback': lambda *args, **kwargs: (None, None),
        'cached_model_source_holder': lambda *args, **kwargs: None,
        'list_all_models': [],
        'is_ensemble_master': False,
        'is_4_stem_ensemble': False
    }

    if args.dry_run:
        print("Dry run complete. All models and dependencies are correctly loaded.")
        sys.exit(0)

    try:
        if process_method == VR_ARCH_TYPE:
            seperator = SeperateVR(model_data, process_data)
        elif process_method == MDX_ARCH_TYPE:
            seperator = SeperateMDXC(model_data, process_data) if model_data.is_mdx_c else SeperateMDX(model_data, process_data)
        elif process_method == DEMUCS_ARCH_TYPE:
            seperator = SeperateDemucs(model_data, process_data)
        else:
            raise ValueError(f"Unknown process method: {process_method}")

        seperator.seperate()
        print("Separation complete.")
    except Exception as e:
        import traceback
        traceback.print_exc()
        print(f"Error during separation: {str(e)}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
